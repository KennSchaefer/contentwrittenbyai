---
import type { CollectionEntry } from 'astro:content';
import { REPO_URL } from '../consts';

interface Props {
  provenance: CollectionEntry<'posts'>['data']['provenance'];
  // Repo-relative path of the source file, used to link its edit history
  filePath?: string;
}

const { provenance: p, filePath } = Astro.props;

const editLabels = {
  none: 'None. Published as the model wrote it',
  light: 'Light. Small fixes to wording or facts',
  moderate: 'Moderate. Sections rewritten or restructured',
  heavy: 'Heavy. Substantially rewritten by a human',
};
const factLabels = {
  'not-needed': 'Not needed (opinion or meta content)',
  pending: 'Pending',
  checked: 'Checked by a human',
};
const historyUrl = filePath ? `${REPO_URL}/commits/main/${filePath}` : REPO_URL;
---

<aside class="provenance" aria-label="How this was made">
  <p class="eyebrow">How this was made</p>
  <dl>
    <dt>Written by</dt>
    <dd>{p.models.join(', ')}</dd>
    <dt>Brief</dt>
    <dd>{p.brief}</dd>
    <dt>Human editing</dt>
    <dd>{editLabels[p.humanEdit]}</dd>
    {p.editor && (<><dt>Editor</dt><dd>{p.editor}</dd></>)}
    <dt>Fact check</dt>
    <dd>{factLabels[p.factCheck]}</dd>
    {p.notes && (<><dt>Notes</dt><dd>{p.notes}</dd></>)}
  </dl>
  <p class="history"><a href={historyUrl}>See every edit to this page on GitHub →</a></p>
</aside>

<style>
  .provenance {
    max-width: var(--measure);
    margin: 3rem 0 0;
    padding: 1.25rem 1.25rem 1rem;
    background: var(--accent-soft);
    border-radius: 10px;
    font-size: 0.95rem;
  }
  .eyebrow { margin: 0 0 0.75rem; }
  dl {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 0.4rem 1rem;
    margin: 0;
  }
  dt { font-weight: 600; }
  dd { margin: 0; }
  .history { margin: 1rem 0 0; }
  @media (max-width: 480px) {
    dl { grid-template-columns: 1fr; gap: 0.1rem; }
    dd { margin-bottom: 0.5rem; }
  }
</style>
