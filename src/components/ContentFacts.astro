---
import type { CollectionEntry } from 'astro:content';
import { REPO_URL, EDITOR_PROFILE } from '../consts';

interface Props {
  post: CollectionEntry<'posts'>;
  ledger?: CollectionEntry<'ledgers'>;
  minutes: number;
  // Words in the editor's "In real life" section (0 when there isn't one, or it's still a sample)
  humanWords?: number;
}

const { post, ledger, minutes, humanWords = 0 } = Astro.props;
const p = post.data.provenance;
const filePath = post.filePath?.replace(/^\.\//, '');
const historyUrl = filePath ? `${REPO_URL}/commits/main/${filePath}` : REPO_URL;

const claims = ledger?.data.claims ?? [];
const editLabel = { none: 'None', light: 'Light', moderate: 'Moderate', heavy: 'Heavy' }[p.humanEdit];
const factLabel = { 'not-needed': 'Not needed', pending: 'Pending', checked: 'Human-approved' }[p.factCheck];
---

<aside class="facts" aria-labelledby="facts-heading">
  <p id="facts-heading" class="title">Content Facts</p>
  <p class="serving">Serving size: 1 article ({minutes} min)</p>
  <dl>
    <div><dt>Written by</dt><dd>{p.models.join(', ')}</dd></div>
    {p.editor && <div><dt>Edited by</dt><dd>{p.editor === EDITOR_PROFILE.name ? <a href={EDITOR_PROFILE.path}>{p.editor}</a> : p.editor}</dd></div>}
    <div><dt>Human editing</dt><dd>{editLabel}</dd></div>
    {humanWords > 0 && <div><dt>Written by a human</dt><dd>{humanWords} words</dd></div>}
    {ledger && <div><dt>Claims checked</dt><dd>{claims.length}</dd></div>}
    {ledger && <div><dt>Claims cut</dt><dd class="cut">{claims.filter((c) => !c.used && c.decision === 'rejected').length}</dd></div>}
    <div class="last"><dt>Fact check</dt><dd>{factLabel}</dd></div>
  </dl>
  <p class="small"><strong>Brief:</strong> {p.brief}</p>
  {p.notes && <p class="small"><strong>Editor's note:</strong> {p.notes}</p>}
  <p class="small"><a href={historyUrl}>Every edit, on GitHub</a></p>
</aside>

<style>
  .facts {
    border: 3px solid var(--text);
    padding: 1rem 1.1rem;
    font-size: 0.9375rem;
    background: var(--bg);
  }
  .title { margin: 0; font: 800 1.75rem/1 var(--sans); letter-spacing: -0.02em; }
  .serving { margin: 0.25rem 0 0; padding-bottom: 0.5rem; border-bottom: 10px solid var(--text); }
  dl { margin: 0; }
  dl div {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.35rem 0;
    border-bottom: 1px solid var(--text);
  }
  dl div.last { border-bottom-width: 6px; }
  dt { font-weight: 700; }
  dd { margin: 0; text-align: right; }
  dd.cut { color: var(--accent); font-weight: 700; }
  .small { margin: 0.7rem 0 0; font-size: 0.8125rem; line-height: 1.45; }
</style>
