---
import type { CollectionEntry } from 'astro:content';
import { SECTIONS } from '../consts';
import { formatDate, postUrl } from '../lib/posts';

interface Props {
  posts: CollectionEntry<'posts'>[];
  showSection?: boolean;
}

const { posts, showSection = true } = Astro.props;
---

<ul class="post-list">
  {posts.map((post) => (
    <li>
      <p class="eyebrow quiet">
        {showSection && <>{SECTIONS[post.data.category].name} · </>}
        <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
        {post.data.draft && ' · Draft'}
      </p>
      <h3><a href={postUrl(post)}>{post.data.title}</a></h3>
      <p class="dek">{post.data.description}</p>
    </li>
  ))}
</ul>

<style>
  .post-list { list-style: none; padding: 0; margin: 0; }
  li { padding: 1.25rem 0; border-bottom: 1px solid var(--border); }
  li:last-child { border-bottom: 0; }
  .eyebrow { margin: 0; font-size: 0.75rem; }
  h3 { margin: 0.4rem 0 0.3rem; font: 600 1.375rem/1.25 var(--serif); }
  h3 a { color: var(--text); text-decoration: none; }
  h3 a:hover { color: var(--accent); }
  .dek { margin: 0; color: var(--muted); font-size: 0.9375rem; }
</style>
