---
import '../styles/global.css';
import { SITE_TITLE, SITE_DESCRIPTION, REPO_URL, SECTIONS, NAV_SECTIONS, GTM_ID, type Section } from '../consts';
import { IS_PREVIEW } from '../lib/posts';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  // Highlights the matching nav item
  section?: Section | 'methodology';
}

const { title, description = SITE_DESCRIPTION, type = 'website', noindex = false, section } = Astro.props;
// Add the site name only when it fits; Google truncates title tags past roughly 60 to 70 characters
const withSite = `${title} | ${SITE_TITLE}`;
const fullTitle = !title ? SITE_TITLE : withSite.length <= 65 ? withSite : title;
const canonical = new URL(Astro.url.pathname, Astro.site);

// Google Tag Manager's standard snippet, as Google provides it
const gtmSnippet = `(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','${GTM_ID}');`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    {!IS_PREVIEW && (
      <>
        <!-- Google Tag Manager -->
        <script is:inline set:html={gtmSnippet}></script>
        <!-- End Google Tag Manager -->
      </>
    )}
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {(noindex || IS_PREVIEW) && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href="/rss.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,600;1,6..72,400&family=Public+Sans:wght@400;600;700;800&family=IBM+Plex+Mono:wght@400;600&family=Caveat:wght@600&display=swap"
    />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta name="twitter:card" content="summary" />
    <slot name="head" />
  </head>
  <body>
    {!IS_PREVIEW && (
      <>
        <!-- Google Tag Manager (noscript) -->
        <noscript><iframe src={`https://www.googletagmanager.com/ns.html?id=${GTM_ID}`} height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
        <!-- End Google Tag Manager (noscript) -->
      </>
    )}
    {IS_PREVIEW && <p class="preview-bar">Preview site: drafts included, not indexed, no analytics. The live site is <a href="https://contentwrittenbyai.com/">contentwrittenbyai.com</a>.</p>}
    <header class="site-header">
      <div class="wrap bar">
        <a class="wordmark" href="/" aria-label={SITE_TITLE}>
          Content Written by <span class="fix"><s>a Human</s><span class="ai" aria-hidden="true">AI</span></span>
        </a>
        <nav aria-label="Main">
          {NAV_SECTIONS.map((key) => (
            <a
              href={SECTIONS[key].path}
              class:list={[{ lab: key === 'lab' }]}
              aria-current={section === key ? 'page' : undefined}
            >
              {SECTIONS[key].name}
            </a>
          ))}
          <a href="/methodology/" class="method" aria-current={section === 'methodology' ? 'page' : undefined}>Methodology</a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap foot">
        <p>Written by AI, reviewed by a human, built in the open. Complaints may be filed in the <a href={REPO_URL}>public repo</a>, where we will read them and probably agree.</p>
        <nav aria-label="Footer">
          <a href="/about/">About</a>
          <a href={REPO_URL}>GitHub</a>
          <a href="/rss.xml">RSS</a>
        </nav>
      </div>
    </footer>
  </body>
</html>

<style>
  .preview-bar {
    margin: 0;
    padding: 0.5rem 1.5rem;
    background: var(--amber-soft);
    color: var(--amber);
    font: 600 0.8125rem var(--sans);
    text-align: center;
  }
  .preview-bar a { color: inherit; }
  .site-header { border-bottom: 1px solid var(--border); }
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    padding-top: 1.4rem;
    padding-bottom: 1.1rem;
  }
  .wordmark {
    font: 600 1.5rem/1.1 var(--serif);
    color: var(--text);
    text-decoration: none;
    white-space: nowrap;
  }
  .fix { position: relative; display: inline-block; }
  .fix s {
    color: var(--muted);
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
  }
  .ai {
    position: absolute;
    left: 0.9rem;
    top: -1.2rem;
    font: 600 1.6rem var(--hand);
    color: var(--accent);
    transform: rotate(-6deg);
  }
  nav { display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; font-size: 0.9375rem; font-weight: 600; }
  nav a { color: var(--text); text-decoration: none; }
  nav a:hover { color: var(--accent); }
  nav a.lab { font-family: var(--mono); color: var(--lab); }
  nav a.method { color: var(--accent); }
  nav a[aria-current='page'] { text-decoration: underline 2px; text-underline-offset: 6px; }

  .site-footer { background: var(--ink); color: var(--ink-text); margin-top: 2rem; }
  .foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem 2rem;
    padding-top: 2.5rem;
    padding-bottom: 2.5rem;
    font-size: 0.875rem;
  }
  .foot p { margin: 0; max-width: 36rem; }
  .foot a { color: #fff; }
  .foot nav { font-weight: 400; font-size: 0.875rem; }
</style>
