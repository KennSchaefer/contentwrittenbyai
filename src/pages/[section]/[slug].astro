---
import { render, getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ContentFacts from '../../components/ContentFacts.astro';
import Ledger from '../../components/Ledger.astro';
import InRealLife from '../../components/InRealLife.astro';
import { getPosts, formatDate, readingMinutes, linkClaims } from '../../lib/posts';
import { SITE_TITLE, SECTIONS, EDITOR_PROFILE, REPO_URL, DATA_LICENSE } from '../../consts';
import { abs, ids, organization, editorPerson, faqFromHtml } from '../../lib/schema';
import { ogKey } from '../../lib/og';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { section: post.data.category, slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, pubDate, updatedDate, category, provenance } = post.data;
const ledger = await getEntry('ledgers', post.id.split('/').pop()!);
const minutes = readingMinutes(post);
const section = SECTIONS[category];
const irl = await getEntry('irl', post.id.split('/').pop()!);
const irlWords = irl ? (irl.body ?? '').split(/\s+/).filter(Boolean).length : 0;
// Markdown posts render through linkClaims so claim marks become tagged links; MDX renders as-is.
// A <div data-irl></div> line in the post places the editor's section; without it the section follows the body.
const html = post.rendered?.html ? linkClaims(post.rendered.html) : null;
const [beforeIrl, afterIrl] = html ? html.split(/<div data-irl=""?><\/div>/) : [null, undefined];

const url = abs(Astro.url.pathname);
const ogImage = abs(`/og/${ogKey(Astro.url.pathname)}.png`);
const editorNode = provenance.editor === EDITOR_PROFILE.name ? editorPerson() : provenance.editor && { '@type': 'Person', name: provenance.editor };
// Every verified source the article relies on, as schema.org citations
const citations = ledger
  ? [...new Map(ledger.data.claims.filter((c) => c.used).map((c) => [c.sourceUrl.split('#')[0], c])).values()].map((c) => ({
      '@type': 'CreativeWork',
      name: c.sourceName,
      url: c.sourceUrl.split('#')[0],
    }))
  : [];
const humanSection = irl && !irl.data.sample && irl.data.author === EDITOR_PROFILE.name;

const article = {
  '@type': 'Article',
  '@id': `${url}#article`,
  isPartOf: { '@id': `${url}#webpage` },
  mainEntityOfPage: { '@id': `${url}#webpage` },
  headline: title,
  description,
  image: [ogImage],
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  author: { '@type': 'Organization', '@id': ids.organization, name: SITE_TITLE, url: abs('/') },
  publisher: organization(),
  ...(editorNode && { editor: editorNode }),
  // The editor wrote the "In real life" section himself
  ...(humanSection && { contributor: editorPerson() }),
  ...(citations.length && { citation: citations }),
  ...(post.data.tags.length && { keywords: post.data.tags.join(', ') }),
  wordCount: (post.body ?? '').split(/\s+/).filter(Boolean).length + irlWords,
};
const faq = html ? faqFromHtml(html) : null;
const dataset = post.data.dataset && {
  '@type': 'Dataset',
  '@id': `${url}#dataset`,
  name: post.data.dataset.name,
  description: post.data.dataset.description,
  url,
  sameAs: `${REPO_URL}/blob/main/${post.data.dataset.file}`,
  creator: { '@id': ids.organization },
  isAccessibleForFree: true,
  license: DATA_LICENSE,
  ...(post.data.dataset.temporalCoverage && { temporalCoverage: post.data.dataset.temporalCoverage }),
  ...(post.data.tags.length && { keywords: post.data.tags }),
  distribution: {
    '@type': 'DataDownload',
    encodingFormat: 'application/json',
    contentUrl: `https://raw.githubusercontent.com/${REPO_URL.split('github.com/')[1]}/main/${post.data.dataset.file}`,
  },
};
const schema = [article, ...(faq ? [{ ...faq, '@id': `${url}#faq` }] : []), ...(dataset ? [dataset] : [])];
---

<Base
  title={post.data.seoTitle ?? title}
  description={description}
  type="article"
  noindex={post.data.draft}
  section={category}
  breadcrumbs={[{ name: section.name, path: section.path }]}
  schema={schema}
>
  <article class="wrap">
    <header>
      <p class="eyebrow"><a href={section.path}>{section.name}</a></p>
      <h1>{title}</h1>
      <p class="lede">{description}</p>
      <ul class="byline">
        <li>Written by <strong>{provenance.models.join(', ')}</strong></li>
        {provenance.editor && <li>Edited by <strong>{provenance.editor === EDITOR_PROFILE.name ? <a href={EDITOR_PROFILE.path}>{provenance.editor}</a> : provenance.editor}</strong></li>}
        <li><time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time></li>
        {updatedDate && <li>Updated {formatDate(updatedDate)}</li>}
        <li>{minutes} min read</li>
      </ul>
    </header>
    <div class="row">
      <div class="main">
        {irl?.data.pullQuote && (
          <blockquote class="pull">
            <p>{irl.data.pullQuote}</p>
            <footer>{irl.data.author}, <a href="#irl-heading">in real life</a>{irl.data.sample && <span class="sample-tag"> (AI-written sample)</span>}</footer>
          </blockquote>
        )}
        <div class="prose">
          {beforeIrl !== null ? <Fragment set:html={beforeIrl} /> : <Content />}
          {irl && <InRealLife entry={irl} />}
          {afterIrl && <Fragment set:html={afterIrl} />}
        </div>
        {ledger && <Ledger ledger={ledger} />}
      </div>
      <div class="side">
        <ContentFacts post={post} ledger={ledger} minutes={minutes} humanWords={irl && !irl.data.sample ? irlWords : 0} />
      </div>
    </div>
  </article>
</Base>

<style>
  article { padding-top: 4rem; padding-bottom: 5rem; }
  header { max-width: 49rem; }
  .eyebrow a { color: inherit; text-decoration: none; }
  h1 { font-size: clamp(2.3rem, 5vw, 3.25rem); }
  .lede { margin: 1.25rem 0 0; font-size: 1.3125rem; }
  .byline { display: flex; flex-wrap: wrap; list-style: none; padding: 0; margin: 1.5rem 0 0; font-size: 0.875rem; color: var(--muted); }
  .byline li + li::before { content: '·'; margin: 0 0.5rem; }
  .byline strong { color: var(--text); }
  .row { display: flex; flex-wrap: wrap; gap: 2.5rem 3.5rem; align-items: flex-start; margin-top: 2.75rem; }
  .main { flex: 999 1 36rem; min-width: 0; max-width: var(--measure); }
  .pull { margin: 0 0 2.5rem; padding-left: 1.25rem; border-left: 3px solid var(--accent); max-width: var(--measure); }
  .pull p { margin: 0; font: italic 1.5rem/1.35 var(--serif); }
  .pull footer { margin-top: 0.5rem; font: 600 1.35rem var(--hand); color: var(--accent); }
  .pull footer a { color: inherit; }
  .sample-tag { font: 600 0.8125rem var(--sans); }
  .side { flex: 1 1 17rem; max-width: 21rem; position: sticky; top: 1.5rem; }
  @media (max-width: 900px) { .side { position: static; max-width: none; } }
</style>
